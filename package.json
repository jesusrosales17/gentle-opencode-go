{
  "name": "gentle-opencode-go",
  "version": "0.1.2",
  "description": "OpenCode Go subscription usage in Gentle Shell's status bar and /gentle:usage panel",
  "type": "module",
  "license": "MIT",
  "author": "Jesús Rosales",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jesusrosales17/gentle-opencode-go.git"
  },
  "homepage": "https://github.com/jesusrosales17/gentle-opencode-go#readme",
  "bugs": {
    "url": "https://github.com/jesusrosales17/gentle-opencode-go/issues"
  },
  "keywords": [
    "pi-package",
    "gentle-shell",
    "opencode",
    "opencode-go",
    "usage",
    "quota"
  ],
  "files": [
    "src/**/*.ts",
    "assets/**",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check": "tsc --noEmit",
    "verify": "npm run check && npm test",
    "prepublishOnly": "npm run verify"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "typescript": "^5.9.3"
  }
}
